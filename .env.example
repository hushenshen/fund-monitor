# ============================================================
# fund-monitor — 环境变量配置
# ============================================================
# 复制此文件为 .env，然后填入你的信息：
#   cp .env.example .env

# --- 富途账号（必填） ---
# 支持：手机号 / 邮箱 / 牛牛号（数字ID）
FUTU_ACCOUNT_ID=

# --- 密码（推荐用 MD5，避免明文泄露） ---
# 生成 MD5 命令（Linux / macOS / Git Bash）：
#   echo -n "你的密码" | md5sum | awk '{print $1}'
# macOS 如果不行，用：
#   echo -n "你的密码" | md5
# PowerShell：
#   [System.BitConverter]::ToString([System.Security.Cryptography.MD5]::Create().ComputeHash([System.Text.Encoding]::UTF8.GetBytes('你的密码'))).Replace('-','').ToLower()
FUTU_ACCOUNT_PWD_MD5=

# --- 已弃用（备选）：明文密码 ---
# 如果设置了上面的 MD5，此项会被忽略。仅在不方便算 MD5 时临时使用。
# FUTU_ACCOUNT_PWD=
